<?xml version="1.0" encoding="utf-8"?>
<!-- App Shortcuts（G5，v3.5.2）：长按图标三项直达；hash extra 由 MainActivity.launchUrl/onNewIntent 消费 -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shortcut-consult"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_consult"
        android:shortcutLongLabel="@string/shortcut_consult_long">
